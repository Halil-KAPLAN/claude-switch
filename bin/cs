#!/usr/bin/env bash
# cs — Claude Switch: switch between Claude Code accounts
#
#   cs status            Show the active account and the status of all accounts
#   cs list              List accounts (same as status)
#   cs use <name>        Switch to <name>
#   cs add <name>        Save the currently active credentials as a new account
#   cs sync              Write the active credentials back to their slot (keeps refreshed tokens)
#   cs rm <name>         Delete an account
#   cs restore           Restore the latest backup to .credentials.json

set -euo pipefail
export PYTHONUTF8=1  # Windows: make python open()/print use UTF-8

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
ACCOUNTS_DIR="$CLAUDE_DIR/accounts"
CREDS="$CLAUDE_DIR/.credentials.json"
# The account's email/organization is NOT stored in the credentials but in the
# oauthAccount block of this file. /usage shows it.
CLAUDE_JSON="${CLAUDE_CONFIG_DIR:+$CLAUDE_CONFIG_DIR/.claude.json}"
CLAUDE_JSON="${CLAUDE_JSON:-$HOME/.claude.json}"
ACTIVE_FILE="$ACCOUNTS_DIR/.active"
BACKUP_DIR="$ACCOUNTS_DIR/.backups"
PY="${CS_PYTHON:-python3}"

if [ -t 1 ]; then
  R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[34m'; D=$'\033[2m'; BD=$'\033[1m'; N=$'\033[0m'
else
  R=; G=; Y=; B=; D=; BD=; N=
fi

die() { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
info() { printf '%s%s%s\n' "$D" "$*" "$N"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }

command -v "$PY" >/dev/null 2>&1 || die "$PY not found (override it with CS_PYTHON)"
mkdir -p "$ACCOUNTS_DIR" "$BACKUP_DIR"
chmod 700 "$ACCOUNTS_DIR" "$BACKUP_DIR" 2>/dev/null || true

slot() { printf '%s/%s.json' "$ACCOUNTS_DIR" "$1"; }
slot_profile() { printf '%s/%s.profile.json' "$ACCOUNTS_DIR" "$1"; }

# Are the live credentials usable? When a refresh fails, Claude Code EMPTIES the
# tokens; copying that empty state into a slot would destroy the account for good.
creds_usable() { slot_usable "$CREDS"; }

slot_usable() {
  [ -f "$1" ] || return 1
  "$PY" - "$1" <<'PY'
import json, sys
try:
    o = json.load(open(sys.argv[1])).get("claudeAiOauth") or {}
except Exception:
    sys.exit(1)
sys.exit(0 if (o.get("accessToken") and o.get("refreshToken")) else 1)
PY
}

# Write the live credentials into a slot — but only if it's safe.
save_slot() {
  local name="$1" mism
  if ! creds_usable; then
    warn "live credentials are empty/invalid (logged out) → '$name' slot KEPT"
    return 0
  fi
  mism=$("$PY" - "$CREDS" "$(slot "$name")" "$CLAUDE_JSON" <<'PY'
import json, sys

def load(p):
    try:
        with open(p) as f:
            return json.load(f)
    except Exception:
        return {}

# Organization of the live session: right after /login this field is NOT YET in
# the credentials, so we also look at oauthAccount in ~/.claude.json — it is
# filled in as soon as the profile is fetched, which closes the verification gap.
live = load(sys.argv[1]).get("organizationUuid") \
    or (load(sys.argv[3]).get("oauthAccount") or {}).get("organizationUuid")
slot = load(sys.argv[2]).get("organizationUuid")

if live and slot and live != slot:
    print("mismatch")
PY
)
  if [ -n "$mism" ]; then
    warn "live session belongs to a different account than '$name' → slot KEPT"
    warn "  if it's a new account: cs add <new-name>"
    return 0
  fi
  cp -p "$CREDS" "$(slot "$name")"
  chmod 600 "$(slot "$name")"
  save_profile "$name"
  return 0
}

# Save the oauthAccount block from ~/.claude.json into the account's profile file.
# IMPORTANT: organizationUuid is used to verify the profile really belongs to that account.
# If you switch before Claude Code has fetched the new account's profile, the old
# account's stale profile would be stored under the wrong name — this check prevents that.
# If the 2nd argument is "force", verification is skipped (explicit user request).
save_profile() {
  local name="$1" mode="${2:-verify}" out
  [ -f "$CLAUDE_JSON" ] || return 0
  out=$("$PY" - "$CLAUDE_JSON" "$(slot_profile "$name")" "$CREDS" "$mode" "$name" <<'PY'
import json, sys, os
cfg_path, dest, creds_path, mode, name = sys.argv[1:6]
try:
    with open(cfg_path) as f:
        cfg = json.load(f)
except Exception:
    sys.exit(0)
oa = cfg.get("oauthAccount")
if not oa:
    sys.exit(0)

if mode != "force":
    try:
        with open(creds_path) as f:
            creds_org = json.load(f).get("organizationUuid")
    except Exception:
        creds_org = None
    prof_org = oa.get("organizationUuid")
    if not creds_org or not prof_org:
        print(f"could not verify the profile for '{name}' (no organizationUuid) → not saved")
        sys.exit(0)
    if creds_org != prof_org:
        print(f"the profile found for '{name}' belongs to another account ({oa.get('emailAddress','?')}) → not saved")
        sys.exit(0)

tmp = dest + ".tmp"
with open(tmp, "w") as f:
    json.dump(oa, f, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, dest)
print(f"saved the profile for '{name}': {oa.get('emailAddress', '?')}")
PY
)
  [ -n "$out" ] && printf '%s\n' "$out"
  return 0
}

# Write the account's profile into ~/.claude.json. If there is no saved profile,
# remove oauthAccount entirely — Claude Code fetches the correct one from the server on startup.
install_profile() {
  local name="$1" src
  src=$(slot_profile "$name")
  if [ ! -f "$CLAUDE_JSON" ]; then
    warn "$CLAUDE_JSON not found — skipped the profile step"
    return 0
  fi
  "$PY" - "$CLAUDE_JSON" "$src" "$CREDS" <<'PY'
import json, sys, os
cfg_path, prof_path, creds_path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(cfg_path) as f:
    cfg = json.load(f)

prof = None
if os.path.exists(prof_path):
    try:
        with open(prof_path) as f:
            prof = json.load(f)
    except Exception:
        prof = None

# Does the saved profile really belong to the new account? If the credentials have an
# organizationUuid, compare; if they differ, drop the profile so the right one comes from the server.
if prof is not None:
    try:
        with open(creds_path) as f:
            creds_org = json.load(f).get("organizationUuid")
    except Exception:
        creds_org = None
    if creds_org and prof.get("organizationUuid") and creds_org != prof["organizationUuid"]:
        print(f"the saved profile belongs to a different account ({prof.get('emailAddress','?')}) → ignored")
        prof = None

if prof is not None:
    cfg["oauthAccount"] = prof
    print(f"profile restored: {prof.get('emailAddress', '?')}")
else:
    if cfg.pop("oauthAccount", None) is None:
        print("no saved profile; oauthAccount was already empty")
    else:
        print("no saved profile → removed oauthAccount, Claude Code will fetch it from the server")
tmp = cfg_path + ".cs-tmp"
with open(tmp, "w") as f:
    json.dump(cfg, f, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, cfg_path)
PY
}

valid_name() {
  case "$1" in
    ''|.*|*/*|*' '*) return 1 ;;
    *) return 0 ;;
  esac
}

accounts() {
  local f b
  for f in "$ACCOUNTS_DIR"/*.json; do
    [ -e "$f" ] || continue
    b=$(basename "$f" .json)
    case "$b" in .*|*.profile) continue ;; esac
    printf '%s\n' "$b"
  done
}

active_name() {
  [ -f "$ACTIVE_FILE" ] && tr -d '[:space:]' < "$ACTIVE_FILE" || true
}

# Find which slot matches .credentials.json by its refreshToken.
# If several slots match (copies of the same account), the recorded active name wins.
detect_active() {
  [ -f "$CREDS" ] || return 0
  "$PY" - "$CREDS" "$ACCOUNTS_DIR" "$(active_name)" <<'PY'
import json, sys, os, glob
def rt(p):
    try:
        with open(p) as f:
            return json.load(f).get("claudeAiOauth", {}).get("refreshToken")
    except Exception:
        return None
cur = rt(sys.argv[1])
recorded = sys.argv[3] if len(sys.argv) > 3 else ""
if cur:
    matches = []
    for p in sorted(glob.glob(os.path.join(sys.argv[2], "*.json"))):
        name = os.path.basename(p)[:-5]
        if name.startswith("."):
            continue
        if rt(p) == cur:
            matches.append(name)
    if matches:
        print(recorded if recorded in matches else matches[0])
PY
}

resolve_active() {
  local a d
  d=$(detect_active)
  if [ -n "$d" ]; then
    printf '%s\n' "$d" > "$ACTIVE_FILE"
    printf '%s\n' "$d"
    return
  fi
  a=$(active_name)
  printf '%s\n' "$a"
}

backup_creds() {
  [ -f "$CREDS" ] || return 0
  local dest
  dest="$BACKUP_DIR/credentials-$(date +%Y%m%d-%H%M%S).json"
  cp -p "$CREDS" "$dest"
  chmod 600 "$dest"
  # keep only the 10 most recent backups
  ls -1t "$BACKUP_DIR"/credentials-*.json 2>/dev/null | tail -n +11 | while read -r old; do rm -f "$old"; done
}

# Turn an account slot into a valid .credentials.json and write it to stdout.
# Missing scopes are filled in from the template file (the current active creds).
# organizationUuid is NOT copied — it's account-specific; Claude Code fills it in on the first refresh.
normalize() {
  "$PY" - "$1" "${2:-}" <<'PY'
import json, sys, os
FALLBACK_SCOPES = ["user:inference"]

with open(sys.argv[1]) as f:
    data = json.load(f)
oauth = data.get("claudeAiOauth")
if not isinstance(oauth, dict):
    sys.exit("claudeAiOauth is missing or malformed: " + sys.argv[1])
for k in ("accessToken", "refreshToken"):
    if not oauth.get(k):
        sys.exit(f"{k} is missing: {sys.argv[1]}")

tpl = {}
tpl_path = sys.argv[2] if len(sys.argv) > 2 else ""
if tpl_path and os.path.exists(tpl_path):
    try:
        with open(tpl_path) as f:
            tpl = json.load(f).get("claudeAiOauth", {}) or {}
    except Exception:
        tpl = {}

if not oauth.get("scopes"):
    oauth["scopes"] = tpl.get("scopes") or FALLBACK_SCOPES
# subscriptionType / rateLimitTier are NOT copied from the template — the plan is account-specific.
# If missing, they stay empty; Claude Code fills them in from the server on the first token refresh.
if not oauth.get("expiresAt"):
    oauth["expiresAt"] = 0

json.dump(data, sys.stdout, indent=2)
PY
}

print_row() {
  local name="$1" marker="$2"
  "$PY" - "$(slot "$name")" "$name" "$marker" "$(slot_profile "$name")" <<'PY'
import json, sys, time, os
path, name, marker = sys.argv[1], sys.argv[2], sys.argv[3]
prof_path = sys.argv[4] if len(sys.argv) > 4 else ""
email = "-"
if prof_path and os.path.exists(prof_path):
    try:
        with open(prof_path) as f:
            email = json.load(f).get("emailAddress") or "-"
    except Exception:
        pass
try:
    with open(path) as f:
        o = json.load(f).get("claudeAiOauth", {})
except Exception as e:
    print(f"  {marker} {name:<12} <unreadable: {e}>")
    sys.exit()
exp = o.get("expiresAt") or 0
now = time.time() * 1000
if not (o.get("accessToken") and o.get("refreshToken")):
    print(f"  {marker} {name:<10} {'-':<9} {email:<26} no tokens → /login required")
    sys.exit()
rexp0 = o.get("refreshTokenExpiresAt")
if rexp0 and rexp0 < now:
    print(f"  {marker} {name:<10} {'-':<9} {email:<26} refresh token expired → /login required")
    sys.exit()
if exp:
    left = (exp - now) / 1000
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(exp / 1000))
    if left <= 0:
        state = f"expired ({when})"
    else:
        h, m = int(left // 3600), int((left % 3600) // 60)
        state = f"{when} ({h}h {m}m left)"
else:
    state = "no expiresAt"
TIERS = {
    "default_claude_max_20x": "max 20x",
    "default_claude_max_5x": "max 5x",
    "default_claude_ai": None,      # not distinctive, show subscriptionType instead
}
sub = o.get("subscriptionType")
tier = o.get("rateLimitTier")
label = TIERS.get(tier, tier) if tier else None
plan = label or sub or "?"
# The refresh token dies after ~30 days and is renewed on every refresh. An unused
# account's clock keeps ticking and nothing refreshes it → it silently falls back to /login.
# Warn when time runs short, so opening the account once is enough to reset the clock.
rnote = ""
if rexp0:
    days = (rexp0 - now) / 86400000
    if days < 7:
        rnote = f"   ⚠ /login needed in {days:.0f} days — open this account once"
print(f"  {marker} {name:<10} {plan:<9} {email:<26} {state}{rnote}")
PY
}

cmd_status() {
  local act cur
  act=$(resolve_active)
  printf '\n%sClaude accounts%s  %s(%s)%s\n\n' "$BD" "$N" "$D" "$ACCOUNTS_DIR" "$N"
  local found=0
  while read -r a; do
    [ -n "$a" ] || continue
    found=1
    if [ "$a" = "$act" ]; then
      printf '%s' "$G"; print_row "$a" "●"; printf '%s' "$N"
    else
      print_row "$a" "○"
    fi
  done < <(accounts)
  [ "$found" = 1 ] || warn "no accounts yet — add one with 'cs add <name>'"
  printf '\n'
  if [ -n "$act" ]; then
    printf '  Active: %s%s%s\n\n' "$BD$G" "$act" "$N"
  else
    warn "could not detect the active account (.credentials.json matches no slot)"
    info "  save the current credentials with 'cs add <name>'"
    printf '\n'
  fi
}

cmd_sync() {
  local act
  act=$(resolve_active)
  [ -n "$act" ] || die "active account unknown, run 'cs add <name>' first"
  [ -f "$CREDS" ] || die "$CREDS not found"
  save_slot "$act"
  ok "active credentials + profile written to the '$act' slot"
}

# Called from hooks: silently keeps the active slot up to date, never returns an error.
cmd_autosync() {
  local act
  act=$(resolve_active 2>/dev/null) || exit 0
  [ -n "$act" ] || exit 0
  creds_usable || exit 0
  save_slot "$act" >/dev/null 2>&1
  exit 0
}

cmd_use() {
  local name="${1:-}"
  [ -n "$name" ] || { cmd_status; die "usage: cs use <name>"; }
  valid_name "$name" || die "invalid account name: $name"
  [ -f "$(slot "$name")" ] || die "no account named '$name'. Available: $(accounts | tr '\n' ' ')"

  local act tmp
  act=$(resolve_active)

  if [ "$act" = "$name" ]; then
    ok "'$name' is already active"
    return
  fi

  # 1) Write the current account's (possibly refreshed) tokens and profile back to its own slot
  if [ -n "$act" ] && [ -f "$CREDS" ]; then
    save_slot "$act"
    info "saved the latest tokens of '$act' to its slot"
  elif [ -f "$CREDS" ]; then
    warn "could not detect the active account; the current .credentials.json was only backed up"
  fi

  # 2) Back up
  backup_creds

  # 2b) If the target slot has no tokens: switch to the "login required" state.
  # We remove the credentials and clear the profile; Claude Code asks for /login on startup,
  # and after login the autosync hook writes the new tokens into this account's slot.
  if ! slot_usable "$(slot "$name")"; then
    rm -f "$CREDS"
    printf '%s\n' "$name" > "$ACTIVE_FILE"
    info "$(install_profile "$name")"
    ok "active account → ${BD}$name${N}  ${Y}(no tokens)${N}"
    printf '\n%s  This account has no saved tokens. Start Claude Code and run %s/login%s.%s\n' "$D" "$BD" "$D$N$D" "$N"
    printf '%s  After login, the tokens are saved to %s.json automatically.%s\n\n' "$D" "$name" "$N"
    return
  fi

  # 3) Write the new account (atomically)
  tmp=$(mktemp "$CLAUDE_DIR/.credentials.json.XXXXXX")
  chmod 600 "$tmp"
  if ! normalize "$(slot "$name")" "$CREDS" > "$tmp"; then
    rm -f "$tmp"
    die "account '$name' is not valid"
  fi
  mv -f "$tmp" "$CREDS"
  chmod 600 "$CREDS"
  printf '%s\n' "$name" > "$ACTIVE_FILE"

  # 4) Swap the email/organization info too
  info "$(install_profile "$name")"

  ok "active account → ${BD}$name${N}"
  print_row "$name" "●"
  printf '\n%s! If you switched WITHOUT CLOSING Claude Code, this change may be lost:%s\n' "$Y" "$N"
  printf '%s  a running session keeps its token in memory and, on exit, overwrites ~/.claude.json%s\n' "$D" "$N"
  printf '%s  with its own copy. Correct order: exit first, then cs use, then start again.%s\n\n' "$D" "$N"
}

cmd_add() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: cs add <name>"
  valid_name "$name" || die "invalid account name: $name"
  [ -f "$CREDS" ] || die "$CREDS not found — log in with 'claude' first"
  if [ -f "$(slot "$name")" ]; then
    die "'$name' already exists. To overwrite it: cs rm $name && cs add $name"
  fi
  creds_usable || die "live credentials are empty/invalid — log in with 'claude' first"
  cp -p "$CREDS" "$(slot "$name")"
  chmod 600 "$(slot "$name")"
  save_profile "$name" force
  printf '%s\n' "$name" > "$ACTIVE_FILE"
  ok "current credentials + profile saved as '$name' and marked active"
}

cmd_rm() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: cs rm <name>"
  valid_name "$name" || die "invalid account name: $name"
  [ -f "$(slot "$name")" ] || die "no account named '$name'"
  [ "$(resolve_active)" = "$name" ] && die "'$name' is the active account — switch to another account first"
  cp -p "$(slot "$name")" "$BACKUP_DIR/removed-$name-$(date +%Y%m%d-%H%M%S).json"
  rm -f "$(slot "$name")" "$(slot_profile "$name")"
  ok "'$name' removed (backup in $BACKUP_DIR)"
}

cmd_profile() {
  local sub="${1:-show}" name="${2:-}"
  case "$sub" in
    save)
      [ -n "$name" ] || die "usage: cs profile save <name>"
      valid_name "$name" || die "invalid account name: $name"
      [ -f "$CLAUDE_JSON" ] || die "$CLAUDE_JSON not found"
      save_profile "$name" force
      [ -f "$(slot_profile "$name")" ] || die "no oauthAccount block in $CLAUDE_JSON"
      cmd_profile show
      ;;
    clear)
      [ -f "$CLAUDE_JSON" ] || die "$CLAUDE_JSON not found"
      "$PY" - "$CLAUDE_JSON" <<'PY'
import json, sys, os
p = sys.argv[1]
with open(p) as f:
    cfg = json.load(f)
if cfg.pop("oauthAccount", None) is None:
    print("oauthAccount was already absent")
else:
    print("oauthAccount removed")
tmp = p + ".cs-tmp"
with open(tmp, "w") as f:
    json.dump(cfg, f, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, p)
PY
      ok "Claude Code will fetch the profile from the server on next startup"
      ;;
    show)
      "$PY" - "$CLAUDE_JSON" <<'PY'
import json, sys, os
p = sys.argv[1]
if not os.path.exists(p):
    print("  (no config)"); raise SystemExit
oa = json.load(open(p)).get("oauthAccount")
if not oa:
    print("  oauthAccount: none → Claude Code will fetch it from the server on startup"); raise SystemExit
for k in ("emailAddress", "organizationName", "organizationType", "organizationRateLimitTier"):
    if oa.get(k) is not None:
        print(f"  {k:<26} {oa[k]}")
PY
      ;;
    *) die "usage: cs profile [show|save <name>|clear]" ;;
  esac
}

# Removes the traces that !cs commands leave in Claude Code's history.
# Claude Code has no setting to turn this off (--no-session-persistence only works
# in --print mode), so the only way is to delete them afterwards.
# Deletes for good, without backups — backups would pile up on every startup.
# DRY RUN by default; to actually delete: cs prune --apply
cmd_prune() {
  local apply=0
  [ "${1:-}" = "--apply" ] && apply=1
  "$PY" - "$CLAUDE_DIR" "$apply" <<'PY'
import json, os, sys, glob, time, re

claude_dir, apply = sys.argv[1], sys.argv[2] == "1"
BASH_RE = re.compile(r"<bash-input>(.*?)</bash-input>", re.S)
hist = os.path.join(claude_dir, "history.jsonl")
projects = os.path.join(claude_dir, "projects")

def is_cs(disp):
    d = (disp or "").strip()
    return d.startswith("!cs") or d.startswith("! cs")

# 1) history.jsonl: !cs lines in the up-arrow history
hit = 0
lines = []
if os.path.exists(hist):
    with open(hist) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except Exception:
                lines.append(line); continue
            if is_cs(rec.get("display")):
                hit += 1
            else:
                lines.append(line)
print(f"history.jsonl : {hit} !cs line(s)" + ("" if hit else " (clean)"))

# 2) Session files where only !cs was run (they show up in the session list)
def texts(msg):
    c = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(c, str):
        return [c]
    if isinstance(c, list):
        return [b.get("text", "") for b in c if isinstance(b, dict)]
    return []

# Reads line by line and stops at the first sign of a real conversation, so a
# large session file costs only its first few lines instead of a full parse.
def only_cs(path):
    saw_cs = False
    with open(path) as f:
        for line in f:
            if not line.strip():
                continue
            r = json.loads(line)
            if r.get("type") == "assistant":       # a real conversation → leave it alone
                return False
            if r.get("type") != "user":
                continue
            for tx in texts(r.get("message") or {}):
                s = tx.strip()
                if not s:
                    continue
                if s.startswith("<bash-input>"):
                    # actually parse the command: names like "docs"/"specs" contain "cs",
                    # so a substring check would match them by mistake
                    for cmd in BASH_RE.findall(s):
                        first = (cmd.strip().lstrip("!").split() or [""])[0]
                        if first != "cs":
                            return False
                        saw_cs = True
                elif not s.startswith(OK_PREFIX):
                    return False
    return saw_cs

# Local slash commands (e.g. /login before 'cs add') don't make a session a real conversation;
# any session the model actually replied in is already kept by the "assistant" check.
OK_PREFIX = ("<bash-input>", "<bash-stdout>", "<bash-stderr>", "<local-command-caveat>",
             "<command-name>", "<local-command-stdout>", "<local-command-stderr>")
victims = []
skipped_live = 0
cur_sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
now_s = time.time()

for path in glob.glob(os.path.join(projects, "*", "*.jsonl")):
    sid = os.path.basename(path)[:-6]
    # DON'T TOUCH the running session's file: Claude Code keeps it open and recreates
    # it on the next write if it's moved. It gets cleaned up on the next startup.
    if cur_sid and sid == cur_sid:
        skipped_live += 1
        continue
    # It may be open in another window — skip it if it was written in the last 2 minutes
    try:
        if now_s - os.path.getmtime(path) < 120:
            skipped_live += 1
            continue
    except OSError:
        continue
    try:
        if only_cs(path):
            victims.append(path)
    except Exception:
        continue

print(f"session files : {len(victims)} !cs-only session(s)"
      + (f"  ({skipped_live} live/recent session(s) skipped)" if skipped_live else ""))
for v in victims:
    print(f"   - {os.path.basename(v)}")

if not apply:
    print("\nDRY RUN — nothing was deleted.")
    print("To apply: cs prune --apply")
    raise SystemExit

if hit:
    tmp = hist + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(lines)
    os.chmod(tmp, 0o600)
    os.replace(tmp, hist)
    print(f"\nhistory.jsonl cleaned ({hit} line(s) removed)")
removed = 0
for v in victims:
    try:
        os.remove(v)
        removed += 1
    except OSError:
        pass
if removed:
    print(f"{removed} session file(s) deleted")
PY
}

cmd_restore() {
  local last
  last=$(ls -1t "$BACKUP_DIR"/credentials-*.json 2>/dev/null | head -1 || true)
  [ -n "$last" ] || die "no backup found"
  cp -p "$last" "$CREDS"
  chmod 600 "$CREDS"
  rm -f "$ACTIVE_FILE"
  ok "restored: $(basename "$last")"
  cmd_status
}

usage() {
  cat <<EOF
${BD}cs${N} — Claude Code account switcher

  ${B}cs status${N}          Active account + token status of all accounts
  ${B}cs list${N}            Same as status
  ${B}cs use <name>${N}      Switch to <name>
  ${B}cs add <name>${N}      Save the current credentials as a new account
  ${B}cs sync${N}            Write the active credentials back to their slot
  ${B}cs rm <name>${N}       Delete an account
  ${B}cs profile${N}         Show the active email/organization
  ${B}cs profile save <name>${N}  Assign the current profile to <name>
  ${B}cs profile clear${N}   Remove the profile → Claude Code fetches it again
  ${B}cs prune${N}           Remove !cs traces from history (delete with --apply)
  ${B}cs restore${N}         Restore the latest .credentials.json backup

Account files:   $ACCOUNTS_DIR/<name>.json
Profile files:   $ACCOUNTS_DIR/<name>.profile.json
The email/organization is stored in the oauthAccount block of $CLAUDE_JSON.
EOF
}

case "${1:-status}" in
  status|st|whoami|current) cmd_status ;;
  list|ls)                  cmd_status ;;
  use|switch|sw)            shift; cmd_use "${1:-}" ;;
  add|save)                 shift; cmd_add "${1:-}" ;;
  sync)                     cmd_sync ;;
  autosync)                 cmd_autosync ;;
  rm|remove|delete)         shift; cmd_rm "${1:-}" ;;
  profile|prof)             shift; cmd_profile "${1:-show}" "${2:-}" ;;
  prune)                    shift; cmd_prune "${1:-}" ;;
  restore)                  cmd_restore ;;
  -h|--help|help)           usage ;;
  *)                        usage; die "unknown command: $1" ;;
esac
